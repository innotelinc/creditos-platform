// CreditOS — Prisma schema (Phase 1: Foundation)
// Multi-tenant, RBAC, credit reports, disputes, letters, audit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  CREDIT_SPECIALIST
  DISPUTE_SPECIALIST
  ATTORNEY
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum Bureau {
  EXPERIAN
  EQUIFAX
  TRANSUNION
  OTHER
}

enum ReportStatus {
  UPLOADED
  PARSING
  PARSED
  ANALYZING
  ANALYZED
  FAILED
}

enum DisputeStatus {
  DRAFT
  ACTIVE
  PENDING_CLIENT
  PENDING_ATTORNEY
  ESCALATED
  RESOLVED
  REJECTED
  CLOSED
}

enum RoundStatus {
  SENT
  DELIVERED
  RECEIVED
  RESPONSE_RECEIVED
  RESOLVED
  REJECTED
  PENDING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ALERT
}

enum DocumentType {
  CREDIT_REPORT
  BUREAU_RESPONSE
  ID_DOCUMENT
  SSN_CARD
  UTILITY_BILL
  POLICE_REPORT
  FTC_REPORT
  SIGNED_LETTER
  CONTRACT
  OTHER
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum LetterStatus {
  DRAFT
  READY
  SENT
  ARCHIVED
}

model Tenant {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  logoUrl      String?
  plan         TenantPlan @default(FREE)
  brandColor   String?    @default("#6366f1")
  emailDomain  String?
  timezone     String     @default("America/New_York")
  settings     Json?      @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  users        User[]
  reports      CreditReport[]
  disputes     Dispute[]
  letters      Letter[]
  letterTemplates LetterTemplate[]
  documents    Document[]
  tasks        Task[]
  notifications Notification[]
  auditLogs    AuditLog[]
  featureFlags FeatureFlag[]
  consents     Consent[]
  subscriptions Subscription[]
  invoices     Invoice[]
  crmLeads     CrmLead[]
  crmActivities CrmActivity[]

  @@index([plan])
}

model User {
  id             String     @id @default(cuid())
  email          String
  passwordHash   String
  name           String
  role           Role       @default(CLIENT)
  status         UserStatus @default(ACTIVE)
  phone          String?
  isSuperAdmin   Boolean    @default(false)
  emailVerifiedAt DateTime?
  totpSecret     String?
  totpEnabled    Boolean    @default(false)
  lastLoginAt    DateTime?
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  tasksAssigned  Task[]         @relation("AssigneeTasks")
  tasksCreated   Task[]         @relation("CreatorTasks")
  lettersCreated Letter[]       @relation("LetterCreator")
  documentsUploaded Document[]  @relation("DocumentUploader")
  disputesAsClient Dispute[]    @relation("DisputeClient")
  reportsAsClient CreditReport[] @relation("ReportClient")
  lettersAsClient Letter[]      @relation("LetterClient")
  documentsAsClient Document[]  @relation("DocumentClient")
  tasksAsClient   Task[]        @relation("TaskClient")
  consents        Consent[]     @relation("ConsentClient")
  leadsOwned      CrmLead[]     @relation("LeadOwner")
  crmActivities   CrmActivity[] @relation("CrmActivityCreator")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model RefreshToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedByTokenId String?
  userAgent     String?
  ip            String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model FeatureFlag {
  id        String  @id @default(cuid())
  key       String
  enabled   Boolean @default(false)
  rules     Json?
  tenantId  String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, tenantId])
}

model CreditReport {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId       String
  client         User         @relation("ReportClient", fields: [clientId], references: [id], onDelete: Cascade)
  bureau         Bureau
  filename       String
  fileKey        String?
  mimeType       String?
  sizeBytes      Int?
  status         ReportStatus @default(UPLOADED)
  parseErrors    Json?
  rawJson        Json?
  analyzedAt     DateTime?
  analysisJson   Json?
  summary        Json?
  pulledAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accounts       CreditAccount[]
  inquiries      CreditInquiry[]
  publicRecords  PublicRecord[]
  scoreSnapshots ScoreSnapshot[]
  disputes       Dispute[]

  @@index([tenantId, clientId, createdAt])
  @@index([bureau])
}

model CreditAccount {
  id              String    @id @default(cuid())
  reportId        String
  report          CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  accountName     String
  accountType     String?
  bureau          Bureau
  accountNumber   String?
  status          String?
  balance         Decimal?  @db.Decimal(14, 2)
  creditLimit     Decimal?  @db.Decimal(14, 2)
  highBalance     Decimal?  @db.Decimal(14, 2)
  paymentHistory  String?
  openedDate      DateTime?
  closedDate      DateTime?
  lastReportedDate DateTime?
  dateFirstDelinquent DateTime?
  monthsNegative  Int?
  isNegative      Boolean   @default(false)
  negativeFlags   Json?
  derogaType      String?
  remark          String?
  createdAt       DateTime  @default(now())

  @@index([reportId])
  @@index([isNegative])
}

model CreditInquiry {
  id        String   @id @default(cuid())
  reportId  String
  report    CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  company   String
  type      String   @default("hard") // hard | soft
  date      DateTime
  createdAt DateTime @default(now())

  @@index([reportId])
}

model PublicRecord {
  id          String   @id @default(cuid())
  reportId    String
  report      CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type        String   // bankruptcy | tax_lien | judgment
  court       String?
  filingDate  DateTime?
  amount      Decimal? @db.Decimal(14, 2)
  status      String?
  createdAt   DateTime @default(now())

  @@index([reportId])
}

model ScoreSnapshot {
  id          String   @id @default(cuid())
  reportId    String
  report      CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  bureau      Bureau
  score       Int
  reasonCodes Json?
  scoreDate   DateTime @default(now())

  @@index([reportId])
}

model Dispute {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String
  client        User          @relation("DisputeClient", fields: [clientId], references: [id], onDelete: Cascade)
  reportId      String?
  report        CreditReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  title         String
  status        DisputeStatus @default(DRAFT)
  currentRound  Int           @default(0)
  priority      TaskPriority  @default(MEDIUM)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  rounds        DisputeRound[]
  letters       Letter[]

  @@index([tenantId, clientId])
  @@index([status])
}

model DisputeRound {
  id            String      @id @default(cuid())
  disputeId     String
  dispute       Dispute     @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  roundNumber   Int
  letterId      String?
  letter        Letter?     @relation(fields: [letterId], references: [id], onDelete: SetNull)
  status        RoundStatus @default(PENDING)
  sentAt        DateTime?
  deliveredAt   DateTime?
  receivedAt    DateTime?
  responseAt    DateTime?
  responseSummary String?
  responsePdfKey  String?
  result        String?
  nextStep      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([disputeId, roundNumber])
}

model LetterTemplate {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  category    String?
  letterType  String
  body        String
  isSystem    Boolean  @default(false)
  version     Int      @default(1)
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  letters     Letter[]

  @@unique([code, tenantId])
  @@index([category])
}

model Letter {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId     String
  client       User         @relation("LetterClient", fields: [clientId], references: [id], onDelete: Cascade)
  disputeId    String?
  dispute      Dispute?     @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  templateId   String?
  template     LetterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title        String
  letterType   String
  body         String
  status       LetterStatus @default(DRAFT)
  version      Int          @default(1)
  createdById  String?
  createdBy    User?        @relation("LetterCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  versions     LetterVersion[]
  rounds       DisputeRound[]

  @@index([tenantId, clientId])
}

model LetterVersion {
  id          String   @id @default(cuid())
  letterId    String
  letter      Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  body        String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([letterId, version])
}

model Document {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId    String
  client      User         @relation("DocumentClient", fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  type        DocumentType @default(OTHER)
  fileKey     String
  mimeType    String?
  sizeBytes   Int?
  metadata    Json?
  uploadedById String?
  uploadedBy  User?        @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([tenantId, clientId])
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId    String?
  client      User?        @relation("TaskClient", fields: [clientId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation("AssigneeTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?        @relation("CreatorTasks", fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueAt       DateTime?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId, status])
  @@index([assigneeId])
}

model Consent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId    String
  client      User     @relation("ConsentClient", fields: [clientId], references: [id], onDelete: Cascade)
  type        String   // credit_authorization | dispute_authorization | marketing | data_processing
  version     String
  acceptedAt  DateTime @default(now())
  ip          String?

  @@unique([clientId, type, version])
}

// ── Pricing & billing (business + consumer models) ─────────────────────────

enum PlanModel {
  BUSINESS // SaaS sold to credit-repair agencies
  CONSUMER // services agencies offer their end clients
}

enum PlanInterval {
  MONTH
  YEAR
  ONE_TIME
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
  REFUNDED
}

model Plan {
  id          String       @id @default(cuid())
  model       PlanModel
  code        String
  name        String
  description String?
  priceCents  Int
  interval    PlanInterval @default(MONTH)
  currency    String       @default("USD")
  popular     Boolean      @default(false)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  features    Json? // string[] shown on the plan card
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([model, code])
  @@index([model, isActive, sortOrder])
}

model Subscription {
  id               String             @id @default(cuid())
  tenantId         String             @unique
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planCode         String
  status           SubscriptionStatus @default(ACTIVE)
  seats            Int                @default(1)
  provider         String             @default("local") // local | stripe
  providerRef      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([planCode])
}

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String
  description String?
  amountCents Int
  currency    String        @default("USD")
  status      InvoiceStatus @default(OPEN)
  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime?
  providerRef String?
  lineItems   Json?
  createdAt   DateTime      @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

// ── CRM (sales pipeline) ────────────────────────────────────────────────────

enum CrmStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum CrmActivityType {
  NOTE
  CALL
  EMAIL
  SMS
  MEETING
}

model CrmLead {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  company        String?
  source         String? // website | referral | facebook | walk-in | cold-call
  stage          CrmStage  @default(NEW)
  value          Int? // deal value in cents
  ownerId        String?
  owner          User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags           Json? // string[]
  notes          String?
  score          Int       @default(0) // 0-100 lead score
  nextFollowUpAt DateTime?
  wonAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  activities     CrmActivity[]
  @@index([tenantId, stage])
}

model CrmActivity {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String
  lead        CrmLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        CrmActivityType @default(NOTE)
  subject     String
  body        String?
  createdById String?
  createdBy   User?           @relation("CrmActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([leadId])
}

// ── Knowledge base / help center ───────────────────────────────────────────

model KnowledgeArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String // getting-started | disputes | letters | compliance | billing | faq
  excerpt   String?
  body      String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
}
