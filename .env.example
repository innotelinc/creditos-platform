# ── CreditOS environment template ────────────────────────────────────────────
# Copy to .env and adjust. Values here mirror docker-compose defaults.

# --- Postgres ---
POSTGRES_USER=creditos
POSTGRES_PASSWORD=creditos
POSTGRES_DB=creditos
DATABASE_URL=postgresql://creditos:creditos@localhost:5432/creditos?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO (S3-compatible storage) ---
# Served from the estate's GHCR mirror of the maintained community CE build
# (ghcr.io/innotelinc/capstone/minio). Upstream minio/minio is no longer
# anonymously pullable from docker.io or quay.io. Override with MINIO_IMAGE.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=creditos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- SMTP (MailHog in local dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CreditOS <no-reply@creditos.local>"

# --- Auth / API ---
JWT_ACCESS_SECRET=884cb537ebdc46473b0a798e329c5e3472b9a72acaaa2f6c5ca43a1718e89f27
JWT_REFRESH_SECRET=87a15c17cb2210f04920b571183885fffc1cda31dac78a8b4d6642441c8a71f5
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
APP_URL=https://credit.innotel.us
API_PORT=3001
WEB_PORT=3000
CORS_ORIGINS=https://credit.innotel.us,http://localhost:3000

# --- AI Provider (OpenAI-compatible proxy, e.g. OpenRouter or your own router) ---
# Leave AI_API_KEY empty to use the built-in deterministic local analysis engine.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-chat
AI_TIMEOUT_MS=60000

# --- Stripe (Phase 3 — Payments & Billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Credit pulls (automatic report ingestion via consumer share codes) ---
# Provider: simulated (default — no credentials needed) | smartcredit | identityiq
CREDIT_PULL_PROVIDER=simulated
# What each automatic pull costs us, in cents — passed through into plan prices.
CREDIT_PULL_COST_CENTS=1200
# Per-pull price (cents) charged for pulls beyond the plan allowance (cost + margin).
CREDIT_PULL_OVERAGE_CENTS=1500
# Overage policy: metered (bill via Stripe usage records; blocks when Stripe is unavailable) | block
CREDIT_PULL_OVERAGE_POLICY=metered
# Resale price (cents) for the consumer Credit Monitoring plan — matches the provider's price.
CREDIT_MONITORING_PRICE_CENTS=2995
# Salt for hashing consumer share codes (falls back to JWT_ACCESS_SECRET).
CREDIT_PULL_SHARE_SECRET=
# SmartCredit partner API (leave empty when using simulated)
SMARTCREDIT_API_BASE_URL=
SMARTCREDIT_API_KEY=
# IdentityIQ partner API (leave empty when using simulated)
IDENTITYIQ_API_BASE_URL=
IDENTITYIQ_API_KEY=
